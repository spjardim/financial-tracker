# Copy to .env and fill in from https://dashboard.plaid.com/developers/keys
# Use Sandbox keys locally; Production keys belong only in the server's environment.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Hours between automatic syncs (0 turns the background sync off).
# PLAID_SYNC_INTERVAL_HOURS=12

# Transactions show up for review from the day each bank is first synced, so ones you already
# entered by hand aren't duplicated. To pull in older ones afterwards, run:
#   flask --app app plaid-backfill --from 2026-11-01

# plaid_link.py appends one line per linked bank login below. Never commit or share these.
# PLAID_ACCESS_TOKEN_CHASE=...
